# Application
APP_NAME=Enterprise Backend
ENVIRONMENT=dev
DEBUG=true
API_V1_PREFIX=/api/v1
APP_PORT=7001
DOCS_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | text（txt 与 text 等价）

# Database
DATABASE_URL=mysql+aiomysql://app:app@localhost:3306/app

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_KEY_PREFIX=session
REFRESH_KEY_PREFIX=refresh
USER_SESSIONS_KEY_PREFIX=user_sessions

# Login rate limiting (per IP, fixed window)
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_RATE_KEY_PREFIX=login:rate:ip

# Login failure lockout (per username)
AUTH_LOGIN_FAILURE_THRESHOLD=5
AUTH_LOGIN_FAILURE_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15
LOGIN_FAILURE_KEY_PREFIX=login:fail:user
LOGIN_LOCK_KEY_PREFIX=login:lock:user

# Extensions
LOGGING_EXT_ENABLED=true
REDIS_EXT_ENABLED=true
DB_EXT_ENABLED=true
ROUTE_EXT_ENABLED=true
MINIO_EXT_ENABLED=false

# Observability (placeholder)
OTEL_ENABLED=false
PROMETHEUS_ENABLED=false

# MinIO (enable when content upload is used)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=change-me
# MINIO_SECRET_KEY=change-me
# MINIO_BUCKET=geo-content
# MINIO_SECURE=false
# MINIO_PRESIGN_EXPIRE_SECONDS=3600

# LLM / Qwen (enable when content generation is used)
# LLM_BACKEND=qwen
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=change-me
# QWEN_MODEL=qwen-plus
